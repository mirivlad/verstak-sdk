{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mirivlad/verstak-sdk/main/schemas/capability-operations.json",
  "title": "Verstak Capability Operations",
  "description": "Contract for public operations exposed by a plugin-provided capability. Operation names are provider-independent; values are declared plugin command ids implementing those operations.",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "minLength": 1
  },
  "additionalProperties": {
    "type": "object",
    "minProperties": 1,
    "propertyNames": {
      "type": "string",
      "minLength": 1
    },
    "additionalProperties": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": { "required": ["verstak/notes/v2"] },
      "then": { "properties": { "verstak/notes/v2": { "$ref": "#/$defs/NotesV2Operations" } } }
    },
    {
      "if": { "required": ["verstak/files/v2"] },
      "then": { "properties": { "verstak/files/v2": { "$ref": "#/$defs/FilesV2Operations" } } }
    },
    {
      "if": { "required": ["verstak/todo/v2"] },
      "then": { "properties": { "verstak/todo/v2": { "$ref": "#/$defs/TodoV2Operations" } } }
    },
    {
      "if": { "required": ["verstak/activity/v2"] },
      "then": { "properties": { "verstak/activity/v2": { "$ref": "#/$defs/ActivityV2Operations" } } }
    }
  ],
  "$defs": {
    "NotesV2Operations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "list": { "type": "string", "minLength": 1 }, "create": { "type": "string", "minLength": 1 }, "open": { "type": "string", "minLength": 1 } }
    },
    "FilesV2Operations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "list": { "type": "string", "minLength": 1 }, "create": { "type": "string", "minLength": 1 }, "open": { "type": "string", "minLength": 1 } }
    },
    "TodoV2Operations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "list": { "type": "string", "minLength": 1 }, "create": { "type": "string", "minLength": 1 }, "setStatus": { "type": "string", "minLength": 1 } }
    },
    "ActivityV2Operations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "list": { "type": "string", "minLength": 1 }, "search": { "type": "string", "minLength": 1 } }
    }
  },
  "examples": [
    {
      "verstak/notes/v1": {
        "list": "verstak.notes.list",
        "get": "verstak.notes.get"
      }
    }
  ]
}
